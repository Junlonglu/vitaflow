# AI 服务（pi-agent 旁路服务）环境变量示例
# 复制为 .env 后按需修改；真实密钥不入库/不提交。

# 服务监听端口
PORT=8300

# 服务间鉴权令牌（FastAPI 的 AI_SERVICE_TOKEN 必须与之一致）
AI_SERVICE_TOKEN=

# Provider 模式：faux（默认，本地确定性，无需真实模型/网络）或
# real（ticket 07：从 .pi-agent/models.json 加载真实模型，见 models.json.example）
PI_PROVIDER=faux

# 真实模型的 API Key（models.json 里以 $DEEPSEEK_API_KEY 引用，不落盘）
DEEPSEEK_API_KEY=

# 单轮 agent 超时（毫秒）
AI_TURN_TIMEOUT_MS=60000

# update_basics_field 工具回调 FastAPI 校验端点使用的基址（不带 /api 后缀）
PI_FASTAPI_BASE_URL=http://127.0.0.1:8000

# 联网搜索工具：none（默认，禁用 web_search 工具）| bocha | tavily
# 必须同时配置 SEARCH_API_KEY 工具才会注册；搜索结果会作为反幻觉证据上报后端
SEARCH_PROVIDER=none
SEARCH_API_KEY=
# 可选：供应商 API 地址覆盖（自建/代理），缺省用适配器内置地址
SEARCH_BASE_URL=
# 单次搜索结果条数上限（1-10，默认 5）
SEARCH_MAX_RESULTS=5
