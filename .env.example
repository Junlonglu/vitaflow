# docker-compose.yml 读取的根目录环境变量示例。
# 复制为 .env 后按需修改；.env 不入库（已在 .gitignore）。

# 服务间鉴权令牌：注入 ai-service 容器，必须与 backend/.env 的 AI_SERVICE_TOKEN 一致（必填）
# 不设置时所有 AI 调用一律 401（双向 fail-closed）
AI_SERVICE_TOKEN=

# AI 服务 Provider 模式：faux（默认，确定性演示）或 real（读取 ai-service/.pi-agent/models.json）
PI_PROVIDER=faux

# real 模式模型 API Key（ai-service/models.json 以 $DEEPSEEK_API_KEY 引用，密钥不落盘）
DEEPSEEK_API_KEY=

# 单轮 agent 超时（毫秒）。真实模型多步工具调用需要余量，默认 5 分钟。
AI_TURN_TIMEOUT_MS=300000

# ai-service 容器回调宿主机 backend 的基址（容器内默认 host.docker.internal:8000）
# 该值在「手动模式」和「全栈模式」都成立：全栈模式 backend 也会发布 8000 端口。
# PI_FASTAPI_BASE_URL=http://host.docker.internal:8000

# =========================
# 全栈 Docker 模式（docker compose --profile full up -d --build）
# =========================
# 后端镜像 apt / PyPI 源。国内默认阿里云；海外可改为官方源
# APT_MIRROR=https://mirrors.aliyun.com
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# 前端 Nginx 入口端口（避开 Windows 上可能被占用的 80）
WEB_PORT=8080
# 后端端口（同时供 ai-service 容器回调）
BACKEND_PORT=8000
# 全栈模式下 DB 用户名/密码/库名跟随 MySQL 服务（这里改了无需再改 backend/.env）
# MYSQL_ROOT_PASSWORD=123456
# MYSQL_DATABASE=vitaflow
# 基础设施端口，按需改（宿主映射端口，容器内端口不变）
# MYSQL_PORT=3306
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# AI_SERVICE_PORT=8300
# 全栈模式下浏览器的跨域来源与前端地址（默认已包含 8080 与 5173）
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
# FRONTEND_URL=http://localhost:8080
